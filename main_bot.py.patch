+    async def get_managed_bot_token(self, context, service_msg) -> str:
+        try:
+            managed_bot = getattr(service_msg, "bot", None)
+            if managed_bot is None:
+                logger.error("ManagedBotCreated message has no bot object.")
+                return ""
+
+            bot_user_id = int(managed_bot.id)
+            token = await context.bot.get_managed_bot_token(user_id=bot_user_id)
+            if token:
+                logger.info(
+                    "Managed bot token retrieved successfully for bot_id=%s",
+                    bot_user_id,
+                )
+                return token
+        except Exception:
+            logger.exception("Failed to retrieve managed bot token from Telegram.")
